<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Приватность: интернет нужен только если пользователь разрешил: раз в сутки спросить GitHub о новой версии
        и раз в несколько часов скачать со своего сайта замены в расписании и новости лицея. И когда пользователь сам
        отправляет письмо в «Написать нам» (уходят только его текст, тип и класс, без имени и контактов).
        Аккаунтов, аналитики и рекламы нет; телефон, номер и место не узнаём.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Android 16: таймер урока чипом в строке состояния (Live Updates). Обычное разрешение, без вопросов -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- ссылки и QR-коды классов: …/Zvonok/#10a и …/Zvonok/10a открывают расписание класса -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="danick-dack.github.io" android:pathPrefix="/Zvonok" />
            </intent-filter>
            <!-- ярлыки на иконке: «Свободные кабинеты», «Неделя», «Найти кабинет» -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- старое имя экрана кабинетов: закреплённые ярлыки из версии 4.0 продолжают работать -->
        <activity-alias
            android:name=".RoomsActivity"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- Большой таймер поверх экрана блокировки (по нажатию на уведомление). Экран не включает, блокировку не снимает -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="app.urok7b.lock"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/LockTheme" />

        <activity
            android:name=".EditorActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".Feedback"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- Обязательная настройка телефона: разрешения, без которых таймер отстаёт или пропадает -->
        <activity
            android:name=".Setup"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <activity
            android:name=".Changelog"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <!-- «Олимпиады» и «Кружки и ШОР» из вкладки «Ещё» -->
        <activity
            android:name=".Pages"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".StyleActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <service
            android:name=".LessonService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Постоянное уведомление с текущим уроком и временем до звонка" />
        </service>

        <!-- Плитка в шторке: урок и сколько до звонка. Живёт, только пока шторка открыта -->
        <service
            android:name=".BellTile"
            android:exported="true"
            android:icon="@drawable/ic_notif"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Внутренние тики и возврат смахнутого уведомления: снаружи недоступен -->
        <receiver
            android:name=".TickReceiver"
            android:exported="false" />

        <!-- Только системные события -->
        <receiver
            android:name=".SystemReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Отдаёт только APK самого приложения и только по явному «Поделиться» -->
        <provider
            android:name=".ApkProvider"
            android:authorities="app.urok7b.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".LessonWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <receiver
            android:name=".MiniWidget"
            android:exported="true"
            android:label="@string/widget_mini_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mini_info" />
        </receiver>

        <receiver
            android:name=".RoomsWidget"
            android:exported="true"
            android:label="@string/widget_rooms_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_rooms_info" />
        </receiver>

        <receiver
            android:name=".DayWidget"
            android:exported="true"
            android:label="@string/widget_day_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_day_info" />
        </receiver>
    </application>
</manifest>
