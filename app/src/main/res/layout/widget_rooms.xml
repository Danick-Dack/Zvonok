<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Кабинеты»: свободные кабинеты сейчас и на следующем уроке -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/r_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/r_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/shape_r26" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/r_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:text="СВОБОДНЫ СЕЙЧАС · 3 УРОК"
            android:textColor="#8A8A8A"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/r_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="3"
            android:text="11  12  20  22  25  27  30  34  40  41  45"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/r_head2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:text="НА 4 УРОКЕ"
            android:textColor="#8A8A8A"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/r_list2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="2"
            android:text="12  20  25  30  41  45  54"
            android:textColor="#D0D0D0"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
